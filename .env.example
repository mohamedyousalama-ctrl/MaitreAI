# ============================================================================
# MaitreAI — WhatsApp Cloud API credentials (Sprint 6)
# Copy to ".env.local" and fill in to enable LIVE WhatsApp.
# When these are absent the app runs in TEST MODE: nothing is sent over the
# network, the WhatsApp card shows "Test mode", and routes return dev responses.
# Never commit real values — .env / .env*.local are gitignored.
# ============================================================================

# Permanent or temporary access token from Meta (Graph API). KEEP SECRET.
WHATSAPP_ACCESS_TOKEN=

# The phone number id (NOT the phone number) from the WhatsApp app.
WHATSAPP_PHONE_NUMBER_ID=

# Arbitrary string you choose; must match what you enter in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=

# App secret used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
