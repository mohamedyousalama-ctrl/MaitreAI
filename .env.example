# ============================================================================
# MaitreAI — Environment variables (NAMES + descriptions only; never commit values)
# Copy to ".env.local" for local dev, or set these in the Vercel dashboard.
# .env / .env*.local are gitignored. With Supabase + Claude unset the app runs in
# DEMO/MOCK mode (localStorage data, deterministic mock LLM, nothing sent).
# ============================================================================

# --- Deployment ------------------------------------------------------------
# App environment label (safe to expose to the client): "development" | "production".
NEXT_PUBLIC_APP_ENV=development
# Optional. Public base URL of the deployment (e.g. https://www.maitre.chat).
# Server-side fallback for building absolute links; the browser uses
# window.location.origin automatically, so usually unnecessary.
NEXT_PUBLIC_APP_URL=

# --- Auth feature flags ----------------------------------------------------
# Phone (SMS) OTP login. OFF by default (email OTP only) until an SMS provider is
# configured in Supabase Auth. Set "true" only once SMS is live.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false

# --- Feature flags (code-only; default OFF) --------------------------------
# Show the operator-side in-app admin chat console («الرئيسية» Maître console).
# Hidden by default; "true" re-enables it (code stays in the tree either way).
NEXT_PUBLIC_ENABLE_ADMIN_CHAT_CONSOLE=false
# Delivery dispatch + driver/customer tracking module. Lands with the stacked
# delivery PR (branch upgrade/delivery); "true" turns it on. (Not read by code on
# the upgrade/order-engine branch yet — listed here for orientation.)
NEXT_PUBLIC_ENABLE_DELIVERY_TRACKING=false

# --- Supabase --------------------------------------------------------------
# When absent the app runs in DEMO MODE (no auth, localStorage). Set to activate
# auth + multi-tenant Postgres. Copy from Supabase → Project Settings → API.
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never expose to the client. Used by the WhatsApp
# webhook, the agent route, seeding, and all service-role reads/writes.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Management API — used by scripts/db-apply.mjs to apply SQL migrations
# (direct Postgres pooler is blocked by network policy). KEEP SECRET.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Claude / Anthropic (the customer + admin agents) ----------------------
# Real Claude calls run when this is set AND AI_ADAPTER != "mock"; otherwise the
# deterministic mock adapter is used. KEEP SECRET.
ANTHROPIC_API_KEY=
# Force the LLM adapter: "mock" pins the deterministic mock (the test suite sets
# this). Leave blank to auto-select Claude when ANTHROPIC_API_KEY is present.
AI_ADAPTER=
# Per-use-case model overrides (defaults in lib/ai/llm/models.ts). Optional.
AI_MODEL_CUSTOMER_AGENT=
AI_MODEL_ADMIN_PARSE=
# Shared secret guarding POST /api/agent/respond (the server-to-server Brain
# entry used by the eval/test harness). KEEP SECRET.
AGENT_ROUTE_SECRET=

# --- Speech-to-text (WhatsApp voice notes) ---------------------------------
# Adapter: "mock" | "openai" | "groq". If unset, auto-selects groq → openai →
# mock based on which key is present.
STT_ADAPTER=
# OpenAI Whisper/transcribe. KEEP SECRET. Model override is optional.
OPENAI_API_KEY=
OPENAI_STT_MODEL=
# Groq Whisper. KEEP SECRET. Model override is optional.
GROQ_API_KEY=
GROQ_STT_MODEL=

# --- WhatsApp Cloud API ----------------------------------------------------
# When the access token + phone number id are absent the app runs in TEST MODE:
# nothing is sent over the network. See docs/WHATSAPP_GO_LIVE.md.
# Permanent (System User) or temporary access token from Meta (Graph API). SECRET.
WHATSAPP_ACCESS_TOKEN=
# The phone number id (NOT the phone number itself) from the WhatsApp app.
WHATSAPP_PHONE_NUMBER_ID=
# Arbitrary string you choose; must match Meta's webhook config (safe to set "test").
WHATSAPP_VERIFY_TOKEN=
# App Secret — verifies the X-Hub-Signature-256 HMAC on inbound webhooks. SECRET.
WHATSAPP_APP_SECRET=
# Maps inbound WhatsApp messages to a tenant (the pilot restaurant id). Until
# per-number routing exists, set this to the live tenant's id.
WHATSAPP_RESTAURANT_ID=
# SANDBOX ESCAPE HATCH — "true" bypasses webhook signature verification so the
# round-trip works while the correct App Secret is sorted out. Turn OFF (unset)
# before real customers. Never ship "true" to production.
WHATSAPP_SKIP_SIGNATURE=

# ============================================================================
# Tooling / scripts only (NOT app runtime) — used by scripts/*.mjs
# ============================================================================
# Base URL the eval/proof harnesses hit (default http://127.0.0.1:3400).
BASE_URL=
# Alternate base-URL vars used by a few older test scripts (auth-redirect-test,
# test-webhook-persist, test-whatsapp-roundtrip). Default to localhost if unset.
APP_URL=
BASE=
# Eval harness: owner user_id whose seeded restaurant to drive, and an optional
# scenario filter. PROOF_CLEANUP=0 keeps proof rows for inspection.
EVAL_OWNER_UID=
EVAL_ONLY=
PROOF_CLEANUP=
