# ============================================================================
# MaitreAI — Environment variables
# Copy to ".env.local" for local dev, or set these in the Vercel dashboard.
# Real secrets are NEVER committed — .env / .env*.local are gitignored.
# ============================================================================

# --- Deployment ------------------------------------------------------------
# App environment label (safe to expose to the client). Use "development" for
# the first production smoke-test deploy, "production" once fully live.
NEXT_PUBLIC_APP_ENV=development

# Optional. Public base URL of the deployment (e.g. https://maitreai.vercel.app).
# Only used as a server-side fallback for building checkout links; the browser
# uses window.location.origin automatically, so this is usually unnecessary.
NEXT_PUBLIC_APP_URL=

# --- Auth feature flags ----------------------------------------------------
# Phone (SMS) OTP login. OFF by default: the الجوال tab stays hidden and email
# OTP is the only sign-in method until an SMS provider (Twilio / MessageBird)
# is configured in Supabase Auth → Providers → Phone (deferred to onboarding
# sprint, see DEPLOYMENT.md). Set to "true" only once SMS is live.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false

# --- Supabase (Sprint 7) ---------------------------------------------------
# When these are absent the app runs in DEMO MODE: no auth, localStorage data,
# existing behavior unchanged. Set them to activate auth + multi-tenant data.
# Create a project at https://supabase.com, then copy from Project Settings → API.
#
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# SERVER ONLY — bypasses RLS. Never expose to the client. Used by the WhatsApp
# webhook and tenant seeding.
SUPABASE_SERVICE_ROLE_KEY=

# --- MIZAN hosted reviewer panel (WO-KHALID-STEP5B) ------------------------
# The /mizan/<token> surface where Saudi reviewers score Khalid's replies. OFF by
# default — the page + /api/mizan/* 404 until this is "true" and you redeploy.
NEXT_PUBLIC_ENABLE_MIZAN_PANEL=
# Comma-separated SHA-256 HASHES of the reviewer URL tokens (never the raw tokens).
# Mint tokens + this line with:  node scripts/mizan/mizan-mint-tokens.mjs --base=https://<deployment>
MIZAN_REVIEWER_TOKEN_HASHES=

# --- WhatsApp Cloud API (Sprint 6 prep — NOT live yet) ---------------------
# When these are absent the app runs in TEST MODE: nothing is sent over the
# network, the WhatsApp card shows "Test mode", and routes return dev responses.
#
# For the initial Vercel deploy, set ONLY a safe placeholder verify token:
#   WHATSAPP_VERIFY_TOKEN=test
# Do NOT add a real access token until you intend to go live.

# Permanent or temporary access token from Meta (Graph API). KEEP SECRET. Leave blank for now.
WHATSAPP_ACCESS_TOKEN=

# The phone number id (NOT the phone number) from the WhatsApp app. Leave blank for now.
WHATSAPP_PHONE_NUMBER_ID=

# Arbitrary string you choose; must match Meta's webhook config. Safe to set to "test".
WHATSAPP_VERIFY_TOKEN=

# MESSAGING app secret — verifies X-Hub-Signature-256 on inbound webhooks (Wesaya).
# WO-SIGNUP-ENV-SPLIT: messaging ONLY. Do NOT set this to the Embedded Signup app's
# secret — that lives in SIGNUP_APP_SECRET below. Leave blank for now.
WHATSAPP_APP_SECRET=

# Messaging app's Meta App ID (Meta App Dashboard → Settings → Basic → App ID).
# No longer used by the signup token exchange (that reads SIGNUP_APP_ID); kept for
# messaging-app identity/reference. Leave blank until the Meta app is set up.
WHATSAPP_APP_ID=

# --- WhatsApp Embedded Signup — DEDICATED app (WO-SIGNUP-ENV-SPLIT) ----------
# The self-serve onboarding token exchange (code → long-lived token) runs against a
# SEPARATE Meta app from messaging, so the messaging secret above is never sent to
# Meta's token endpoint. Server-side only; NEVER exposed to the client. If either is
# blank, POST /api/onboarding/embedded-signup returns a clean not_configured (503) —
# it never falls back to WHATSAPP_APP_SECRET.
SIGNUP_APP_ID=
SIGNUP_APP_SECRET=

# --- WhatsApp Embedded Signup — CLIENT-side (public, safe to expose) --------
# These NEXT_PUBLIC_* vars are read ONLY by the onboarding واتساب step to open
# Meta's Embedded Signup popup — point them at the DEDICATED signup app (same app
# as SIGNUP_APP_ID above). No server secret is ever exposed to the client. While
# either is blank the واتساب step degrades honestly to a "not configured yet" state
# — no broken popup. Values are Mohamed's Meta-side config.
#
# The signup app's Meta App ID, exposed to the browser for FB.init(). = SIGNUP_APP_ID.
NEXT_PUBLIC_WHATSAPP_APP_ID=
# Embedded Signup configuration ID — Meta App Dashboard → WhatsApp → Configuration.
# Required for the FB.login() call that opens the Meta consent modal.
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# Cron (item 17) — shared secret for the scheduled retry-jobs drain.
# Set this in Vercel env; Vercel Cron auto-sends it as `Authorization: Bearer $CRON_SECRET`.
# Manual/external callers send it as the `x-cron-secret` header. Unset → the route is closed (401).
# Also guards /api/monitor/sweep (WO-MONITORING-ALERTING), triggered by the GitHub
# Actions uptime-monitor workflow. Put the SAME value in the GH Actions secret CRON_SECRET.
CRON_SECRET=

# ── Monitoring & alerts (WO-MONITORING-ALERTING) ────────────────────────────
# Alert delivery. WhatsApp-to-Mohamed is the live channel; email is a dormant
# scaffold until a provider is wired (see lib/alerts/email.ts).
ALERT_WHATSAPP_TO=                 # Mohamed's number, E.164 WITHOUT '+' (e.g. 9665XXXXXXXX). Unset → WhatsApp alerts off.
ALERT_EMAILS=                      # comma-separated recipients; only used once an email provider is wired.
ALERT_PLATFORM_RESTAURANT_ID=      # optional: restaurant to attach platform-wide alerts' banner to (else the primary tenant).

# Monitor sweep thresholds (all optional — sane defaults in lib/monitoring/config.ts).
MONITOR_DELIVERY_SILENCE_MIN=      # minutes of inbound silence while OPEN+live before alerting (default 30).
MONITOR_DORMANT_HOURS=             # a channel silent longer than this is "dormant", not down (default 24).
MONITOR_WEBHOOK_SPIKE_COUNT=       # 401/unresolved webhook events in-window before alerting (default 5).
MONITOR_WEBHOOK_WINDOW_MIN=        # window for the webhook-spike count (default 15).
MONITOR_ERROR_RATE=                # agent error ratio 0..1 before alerting (default 0.5).
MONITOR_ERROR_MIN_SAMPLE=          # min turns in-window before the rate can alert (default 4).
MONITOR_ERROR_WINDOW_MIN=          # window for the error-rate rollup (default 15).
MONITOR_DAILY_BUDGET_USD=          # daily Anthropic spend budget; 0/unset → spend alerting OFF.
MONITOR_COOLDOWN_MIN=              # per-alert cooldown to prevent storms (default 60).
MONITOR_WEBHOOK_RETENTION_MIN=     # prune monitor_webhook_events older than this (default 1440).

# Graceful degradation (Part 2): optional per-request timeout (ms) for the customer
# agent's Claude call. UNSET → no timeout (byte-identical to today). Set to fail a
# hung call fast into the customer fallback, e.g. 60000.
AGENT_TIMEOUT_MS=
