{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kivo.local/schemas/brain/gold-set-annotation.schema.json",
  "title": "KTDK Gold Set Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "population", "turns"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "brain-gold-v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "$ref": "#/$defs/evaluation_population"
    },
    "notes": {
      "type": "string"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/turn_annotation"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "evaluation_population": {
      "type": "string",
      "enum": [
        "boundaries",
        "back_to_back",
        "abandoned",
        "reorders",
        "amendments",
        "compound_mutations",
        "references",
        "delivery_zones",
        "price_confirm",
        "duplicate_webhooks",
        "takeover_races",
        "safety_text",
        "safety_voice",
        "prompt_injection",
        "unknown_items",
        "timeouts"
      ]
    },
    "episode_relation": {
      "type": "string",
      "enum": [
        "new_episode",
        "same_episode",
        "reopen_existing",
        "ignore_duplicate",
        "handoff_only",
        "no_order_episode"
      ]
    },
    "user_intent": {
      "type": "string",
      "enum": [
        "order",
        "amend",
        "confirm",
        "cancel",
        "ask_ingredient",
        "ask_status",
        "smalltalk",
        "staff_request",
        "prompt_injection",
        "unknown"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "add_item",
            "remove_item",
            "replace_item",
            "set_quantity",
            "set_address",
            "set_fulfillment",
            "confirm_quote",
            "disclose_safety",
            "request_human",
            "no_op"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "value": {},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cart_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["no_change", "replace_cart", "apply_operations"]
        },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "safety_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requires_kitchen_note", "requires_human_escalation"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["none", "possible", "disclosed", "blocked", "human_required"]
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "requires_kitchen_note": {
          "type": "boolean"
        },
        "requires_human_escalation": {
          "type": "boolean"
        },
        "canonical_disclosure": {
          "type": "string"
        }
      }
    },
    "response_plan_type": {
      "type": "string",
      "enum": [
        "ask_clarification",
        "quote_summary",
        "safety_clarification",
        "human_handoff",
        "reject_unsafe_claim",
        "confirm_commit",
        "no_reply_duplicate",
        "informational_answer"
      ]
    },
    "order_outcome": {
      "type": "string",
      "enum": [
        "none",
        "draft_updated",
        "quote_created",
        "committed",
        "blocked_for_safety",
        "blocked_for_money",
        "duplicate_ignored",
        "human_controlled"
      ]
    },
    "turn_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "tenant_id",
        "thread_id",
        "correct_episode_id",
        "episode_relation",
        "user_intent",
        "operations",
        "entities",
        "cart_delta",
        "next_required_field",
        "safety_state",
        "correct_response_plan_type",
        "expected_order_outcome",
        "evidence_refs"
      ],
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "$ref": "#/$defs/uuid"
        },
        "thread_id": {
          "$ref": "#/$defs/uuid"
        },
        "correct_episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_relation": {
          "$ref": "#/$defs/episode_relation"
        },
        "user_intent": {
          "$ref": "#/$defs/user_intent"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "entities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "items": {
              "type": "array"
            },
            "quantities": {
              "type": "array"
            },
            "modifiers": {
              "type": "array"
            },
            "address": {},
            "delivery_zone": {},
            "time": {},
            "payment_method": {},
            "promotion": {},
            "safety_terms": {
              "type": "array"
            },
            "references": {
              "type": "array"
            }
          }
        },
        "cart_delta": {
          "$ref": "#/$defs/cart_delta"
        },
        "next_required_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "safety_state": {
          "$ref": "#/$defs/safety_state"
        },
        "correct_response_plan_type": {
          "$ref": "#/$defs/response_plan_type"
        },
        "expected_order_outcome": {
          "$ref": "#/$defs/order_outcome"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
